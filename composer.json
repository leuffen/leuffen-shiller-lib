{
  "name": "leuffen/leuffen-shiller-lib",
  "type": "library",
  "description": "Typed access layer for Jekyll/Schiller website sources",
  "license": "MIT",
  "authors": [{"name":"Matthias Leuffen","email":"leuffen@continue.de"}],
  "autoload": {"classmap":["src/"]},
  "require": {"php":">=8.3","ext-yaml":"*","ext-json":"*"},
  "require-dev": {"phpunit/phpunit":"^12.0"},
  "config": {"preferred-install":"source","allow-plugins":{"php-http/discovery":false}},
  "minimum-stability":"dev",
  "scripts": {"test":"phpunit"}
}

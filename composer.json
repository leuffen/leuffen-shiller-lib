{
  "name": "phore/project",
  "type": "library",
  "description": "",
  "license": "MIT",
  "authors": [
    {
      "name": "Matthias Leuffen",
      "email": "leuffen@continue.de"
    }
  ],
  "autoload": {
    "psr-4": {
      "Phore\\FileSystem\\": "src/"
    },
    "files": [
      "src/functions.php"
    ]
  },
  "require": {
    "php": ">=8.3",
    "ext-yaml": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.0",
    "phpunit/phpunit": "^13.2.2"
  },
  "suggest": {},
  "config": {
    "preferred-install": "source",
    "allow-plugins": {
      "php-http/discovery": false
    }
  },
  "minimum-stability": "dev",
  "scripts": {
    "lint": "php-cs-fixer fix --dry-run --diff --verbose",
    "fix": "php-cs-fixer fix --verbose"
  }
}

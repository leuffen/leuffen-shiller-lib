{
  "name": "leuffen/leuffen-shiller-lib",
  "type": "library",
  "description": "Typed access layer for Jekyll/Schiller website sources",
  "license": "MIT",
  "authors": [
    {
      "name": "Matthias Leuffen",
      "email": "leuffen@continue.de"
    }
  ],
  "autoload": {
    "classmap": [
      "src/"
    ]
  },
  "require": {
    "php": ">=8.3",
    "ext-yaml": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.0",
    "phpunit/phpunit": "^12.0"
  },
  "config": {
    "preferred-install": "source",
    "allow-plugins": {
      "php-http/discovery": false
    }
  },
  "minimum-stability": "dev",
  "scripts": {
    "lint": "php-cs-fixer fix --dry-run --diff --verbose",
    "fix": "php-cs-fixer fix --verbose",
    "test": "phpunit"
  }
}

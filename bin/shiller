#!/usr/bin/env php
<?php

declare(strict_types=1);

if (is_file(__DIR__ . '/../vendor/autoload.php')) {
    require __DIR__ . '/../vendor/autoload.php';
} else {
    require __DIR__ . '/../../../autoload.php';
}

$app = new \Phore\Cli\CliApplication();
$app->addClass(\Leuffen\Shiller\Automation\ShillerInitCli::class);
$app->addClass(\Leuffen\Shiller\Automation\ShillerContextCli::class);
$app->addClass(\Leuffen\Shiller\Automation\ShillerCli::class);
$app->addClass(\Leuffen\Shiller\Automation\ShillerEditCli::class);

try {
    $scope = ($argv[1] ?? '') === 'edit' ? [] : ['shiller'];
    echo $app->run([$argv[0], ...$scope, ...array_slice($argv, 1)]);
} catch (\Throwable $exception) {
    \Phore\Cli\Output\Out::TextDanger($exception->getMessage());
    exit(1);
}
